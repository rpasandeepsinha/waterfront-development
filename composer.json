{
    "name": "sandwave/waterfront",
    "type": "project",
    "description": "Waterfront",
    "keywords": [],
    "license": "proprietary",
    "scripts": {
        "lint": [
            "vendor/bin/rector process",
            "composer style:fix",
            "vendor/bin/phpstan --memory-limit=2G"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ],
        "rector": [
            "vendor/bin/rector process --dry-run --memory-limit=2G"
        ],
        "rector:fix": [
            "vendor/bin/rector process"
        ],
        "stack": [
            "composer lint",
            "composer test"
        ],
        "stan": [
            "vendor/bin/phpstan --memory-limit=2G"
        ],
        "stan-debug": [
            "vendor/bin/phpstan --memory-limit=2G --debug"
        ],
        "style": [
            "vendor/bin/mago format --check"
        ],
        "style:fix": [
            "vendor/bin/mago format"
        ],
        "test": [
            "@php artisan test -p --no-coverage"
        ],
        "test:coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "@php artisan test -p --coverage-html test-coverage"
        ]
    },
    "require": {
        "php": ">=8.4",
        "ext-bcmath": "*",
        "ext-dom": "*",
        "ext-grpc": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-opentelemetry": "*",
        "ext-simplexml": "*",
        "axlon/laravel-postal-code-validation": "^3.9",
        "defuse/php-encryption": "^2.2.1",
        "fedeisas/laravel-mail-css-inliner": "^6.0",
        "guzzlehttp/guzzle": "^7.3.0",
        "interaction-design-foundation/nova-html-card": "^3.4",
        "jeremykendall/php-domain-parser": "^6.1",
        "laminas/laminas-hydrator": "^4.2",
        "laravel/framework": "^13.0",
        "laravel/horizon": "^5.7",
        "laravel/nova": "^5.10",
        "laravel/tinker": "^3.0",
        "league/flysystem-aws-s3-v3": "^3.0.13",
        "markwalet/nova-modal-response": "^1.2",
        "mikepultz/netdns2": "^2.0",
        "monarobase/country-list": "^3.2.0",
        "monolog/monolog": "^3.5.0",
        "nesbot/carbon": "^3.0",
        "open-telemetry/exporter-otlp": "^1.4",
        "open-telemetry/opentelemetry-auto-laravel": "^1.7",
        "open-telemetry/opentelemetry-logger-monolog": "^1.2",
        "open-telemetry/sdk": "^1.14",
        "open-telemetry/transport-grpc": "^1.2",
        "owen-it/laravel-auditing": "^14.0",
        "php-amqplib/php-amqplib": "^3.0",
        "phpdocumentor/reflection-docblock": "^6.0",
        "phpseclib/phpseclib": "^3.0",
        "propaganistas/laravel-phone": "^6.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "purplepixie/phpdns": "^2.1",
        "ramsey/uuid": "^4.9",
        "realtimeregister/realtimeregister-php": "^1.5.1",
        "saloonphp/saloon": "^4.0",
        "sandwave-io/basekit-php": "^0.1.12",
        "sandwave-io/harbor-messages": "2.3.*",
        "sandwave-io/lighthouse-auth-base": "^1.20.1",
        "sandwave-io/microsoft-graph-client": "^1.1",
        "sandwave-io/office-365-php": "^0.6.0",
        "sandwave-io/vat": "^1.0.0",
        "sentry/sentry-laravel": "^4.0",
        "spatie/array-to-xml": "^3.1.0",
        "spatie/ssl-certificate": "^2.2.0",
        "symfony/cache": "^8.0",
        "symfony/console": "^8.0",
        "symfony/finder": "^8.0",
        "symfony/http-foundation": "^8.0",
        "symfony/http-kernel": "^8.0",
        "symfony/mailer": "^8.0",
        "symfony/mime": "^8.0",
        "symfony/property-access": "^8.0",
        "symfony/property-info": "^8.0",
        "symfony/serializer": "^8.0",
        "vlucas/phpdotenv": "^5.6.0",
        "web-token/jwt-library": "^4.0",
        "webmozart/assert": "^2.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.8",
        "carthage-software/mago": "^1.47",
        "driftingly/rector-laravel": "^2.0.0",
        "ekino/phpstan-banned-code": "^3.0.0",
        "ergebnis/composer-normalize": "^2.13",
        "ergebnis/phpstan-rules": "^2.0.0",
        "fakerphp/faker": "^1.24.0",
        "friendsofphp/php-cs-fixer": "^3.8",
        "larastan/larastan": "^3.2.0",
        "mockery/mockery": "^1.4.3",
        "nunomaduro/collision": "^8.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-mockery": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^13.0",
        "rector/rector": "^2.0",
        "spaze/phpstan-disallowed-calls": "^4.0",
        "thecodingmachine/phpstan-strict-rules": "^2.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.sandwave.io/api/v4/group/8/-/packages/composer/"
        },
        {
            "type": "composer",
            "url": "https://git.sandwave.io/api/v4/group/8/-/packages/composer/packages.json"
        },
        {
            "type": "composer",
            "url": "https://git.sandwave.io/api/v4/group/55/-/packages/composer/packages.json"
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Waterfront\\": "src/"
        },
        "classmap": [
            "database/seeds"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.8"
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "gitlab-domains": ["git.sandwave.io"],
        "process-timeout": 500,
        "allow-plugins": {
            "carthage-software/mago": true,
            "ergebnis/composer-normalize": true,
            "php-http/discovery": false,
            "tbachert/spi": false
        }
    }
}
